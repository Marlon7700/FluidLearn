rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function authEmail() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function allowlistedAdminEmail() {
      return authEmail() == 'admin@usb.ve'
        || authEmail() == 'administracion@usb.ve'
        || authEmail() == 'maopromaster11@gmail.com'
        || authEmail() == 'martingmailcom95@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        allowlistedAdminEmail()
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == 'ADMIN'
          )
        )
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function classroomRead() {
      return isSignedIn();
    }

    function classroomWrite() {
      return isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
        );

      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Tabla / colección de administradores (correos + OTP).
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == adminId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'admin';

      allow update: if isOwner(adminId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Cola opcional para extensión "Trigger Email from Firestore".
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /published_skill_quizzes/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /course_skills/{skillId} {
      allow read: if classroomRead();
      allow create, update, delete: if classroomWrite();
    }

    match /course_activities/{activityId} {
      allow read: if classroomRead();
      allow create, update, delete: if classroomWrite();
    }

    match /course_units/{unitId} {
      allow read: if classroomRead();
      allow create, update, delete: if classroomWrite();
    }

    match /course_notices/{noticeId} {
      allow read: if classroomRead();
      allow create, update, delete: if classroomWrite();
    }

    match /course_guides/{guideId} {
      allow read: if classroomRead();
      allow create, update, delete: if classroomWrite();
    }

    match /courses/{skillId}/participants/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }
  }
}
