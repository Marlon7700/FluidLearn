# Copia este archivo a `.env` y rellena los valores desde
# Firebase Console → Configuración del proyecto → Tus apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pu-fluidlearn.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pu-fluidlearn
VITE_FIREBASE_STORAGE_BUCKET=pu-fluidlearn.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Envío de códigos admin al correo (elige uno):
# 1) EmailJS — https://www.emailjs.com/ (plantilla: to_email, message, code)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# 2) Web3Forms — https://web3forms.com/ (access key gratis)
VITE_WEB3FORMS_ACCESS_KEY=
# 3) Sin claves: FormSubmit (1ª vez confirma el enlace en tu bandeja)
# 4) Extensión Firebase Trigger Email:
# VITE_USE_FIRESTORE_MAIL=true

